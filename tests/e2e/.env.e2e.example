# E2E Test Environment Configuration
# Copy this file to .env.e2e and fill in your values
# NEVER commit .env.e2e to version control

# =============================================================================
# TARGET ENVIRONMENT
# =============================================================================
# For testing against production:
APP_BASE_URL=https://apps.quentinspencer.com/churchcoursetracker
API_BASE_URL=https://tinev5iszf.execute-api.us-east-1.amazonaws.com

# For testing against local development:
# APP_BASE_URL=http://localhost:4200
# API_BASE_URL=http://localhost:8000

# =============================================================================
# TEST USER CREDENTIALS
# =============================================================================
# These users must exist in the target environment's database
# For production, use the actual test user credentials
# For local dev, these will be created by the setup script

# Admin user (full access)
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

# Staff user (operational access)
E2E_STAFF_USERNAME=
E2E_STAFF_PASSWORD=

# Viewer user (read-only access)
E2E_VIEWER_USERNAME=
E2E_VIEWER_PASSWORD=

# =============================================================================
# DATA LOADING OPTIONS
# =============================================================================
# Skip loading test data (use existing data in database)
# E2E_SKIP_DATA_LOAD=true

# Skip cleaning up test data after tests
# E2E_SKIP_DATA_CLEANUP=true
